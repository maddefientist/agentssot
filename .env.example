# Core database
POSTGRES_DB=ssot
POSTGRES_USER=ssot
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql+psycopg://ssot:change_me_strong_password@db:5432/ssot

# API
API_PORT=8088
API_BIND_HOST=127.0.0.1
LOG_LEVEL=info
DEFAULT_TOP_K=5
MAX_SNIPPET_CHARS=900

# Experimental operator HUD/gateway. Disabled by default because it can recall
# shared memory and invoke model/tool executors. When enabled, only admin keys
# authorized for the gateway namespace can mint short-lived browser tickets.
GATEWAY_ENABLED=false
GATEWAY_EXECUTION_ENABLED=false
GATEWAY_TICKET_TTL_SECONDS=60
GATEWAY_MAX_TEXT_CHARS=8000
GATEWAY_MAX_FRAME_BYTES=16384
GATEWAY_MAX_MESSAGES_PER_MINUTE=30
GATEWAY_MAX_CONNECTIONS=8
GATEWAY_CONNECTION_TTL_SECONDS=300
GATEWAY_REVALIDATE_SECONDS=15

# Authentication and bootstrap
# Required only when the database has no API keys. Generate a unique value,
# start once, then remove it from .env after the key is stored in the database.
BOOTSTRAP_ADMIN_API_KEY=
# Comma-separated fallback namespaces used for the first bootstrap admin key
BOOTSTRAP_ADMIN_NAMESPACES=default
# Agent admission uses admin-issued, single-use tokens through POST /enroll.
# Passphrase-based self-service enrollment is intentionally not shipped.

# Exact record IDs are the default feedback contract. Fuzzy nearest-neighbour
# feedback is an admin-only diagnostic and must be explicitly enabled.
FUZZY_FEEDBACK_ENABLED=false

# Embeddings plugin
EMBEDDING_PROVIDER=none
# NOTE: Embedding dimension must match your embedding model output.
# For Ollama `qwen3-embedding:latest`, the dimension is 4096.
EMBEDDING_DIM=1536
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
# Run embeddings on CPU to avoid GPU memory contention with inference models
OLLAMA_EMBED_CPU_ONLY=true

# LLM summarizer plugin
LLM_PROVIDER=none
OPENAI_CHAT_MODEL=gpt-4o-mini
OLLAMA_CHAT_MODEL=llama3.1

# Session compaction
COMPACTION_ENABLED=true
COMPACTION_EVENT_THRESHOLD=80
COMPACTION_CHAR_THRESHOLD=24000
COMPACTION_INTERVAL_SECONDS=60

# Vector index toggle
ENABLE_HNSW_INDEX=false

# Optional DB exposure (use `docker compose --profile db-port up -d` only when true)
EXPOSE_DB_PORT=false

# Backups
BACKUP_RETENTION_DAYS=14

# Optional pgAdmin profile
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me

# Alerting (channel-agnostic webhook; empty = no-op)
ALERT_ENABLED=true
ALERT_WEBHOOK_URL=
ALERT_HOST_LABEL=agentssot
